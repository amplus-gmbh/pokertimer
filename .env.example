PORT=3000

# Hostinger MySQL credentials. Create the database and database user in hPanel first.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=replace_with_a_long_password

# Protect the public timer controls with HTTP Basic Authentication.
APP_USER=admin
APP_PASSWORD=replace_with_a_long_unique_password

# Optional: OpenAI-compatible Blindstruktur-Erstellung aktivieren.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
